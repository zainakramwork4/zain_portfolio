# ==========================================
# Email / Contact Form (server-side only)
# ==========================================
GMAIL_USER=your_gmail_address
GMAIL_PASSWORD=your_gmail_app_password

# ==========================================
# GitHub Profile / Stats
# ==========================================
NEXT_PUBLIC_GITHUB_USERNAME=zainakramwork4
GITHUB_USERNAME=zainakramwork4

# Optional GitHub Personal Access Token.
# Server-side only. Never use NEXT_PUBLIC_ for this token.
# A token increases GitHub API rate limits.
GITHUB_TOKEN=your_github_token

# ==========================================
# GitHub Streak
# ==========================================
# Your working self-hosted streak deployment.
NEXT_PUBLIC_GITHUB_STREAK_STATS_URL=https://github-readme-streak-stats-rho-rust.vercel.app/
GITHUB_STREAK_STATS_URL=https://github-readme-streak-stats-rho-rust.vercel.app/

# ==========================================
# Legacy / optional external stats base URL
# ==========================================
# Keep only if another part of the project still uses it.
NEXT_PUBLIC_GITHUB_STATS_URL=https://github-readme-stats.vercel.app

# ==========================================
# EmailJS (only if EmailJS is used elsewhere)
# ==========================================
NEXT_PUBLIC_SERVICE_ID=YOUR_SERVICE_ID
NEXT_PUBLIC_TEMPLATE_ID=YOUR_TEMPLATE_ID
NEXT_PUBLIC_PUBLIC_KEY=YOUR_PUBLIC_KEY
