# ==========================================
# Contact Form — SMTP (server-side only)
# ==========================================
# Gmail SMTP example. Use a Gmail App Password,
# not your normal Gmail account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address
SMTP_PASSWORD=your_gmail_app_password
CONTACT_TO_EMAIL=zainakram.work4@gmail.com

# ==========================================
# GitHub Profile / Stats
# ==========================================
NEXT_PUBLIC_GITHUB_USERNAME=zainakramwork4
GITHUB_USERNAME=zainakramwork4

# Optional server-side token to increase GitHub API rate limits.
# NEVER expose this as NEXT_PUBLIC_GITHUB_TOKEN.
GITHUB_TOKEN=your_github_token

# ==========================================
# GitHub Streak
# ==========================================
NEXT_PUBLIC_GITHUB_STREAK_STATS_URL=https://github-readme-streak-stats-rho-rust.vercel.app/
GITHUB_STREAK_STATS_URL=https://github-readme-streak-stats-rho-rust.vercel.app/
